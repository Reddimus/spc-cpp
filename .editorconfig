# https://editorconfig.org
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Matches .clang-format.
[*.{cpp,hpp,in}]
indent_style = tab
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml,json,py,sh}]
indent_style = space

[*.{yml,yaml,json,sh}]
indent_size = 2

[*.py]
indent_size = 4

# Markdown uses trailing spaces for line breaks.
[*.md]
trim_trailing_whitespace = false

# Captured payloads stay byte-for-byte as served.
[tests/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
